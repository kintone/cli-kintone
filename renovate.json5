{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":ignoreModulesAndTests",
    ":label(renovate)",
    ":timezone(Asia/Tokyo)",
    "group:monorepos",
    ":widenPeerDependencies",
    ":prImmediately",
    ":dependencyDashboard",
    ":prConcurrentLimitNone",
  ],
  minimumReleaseAge: "14 days",
  rangeStrategy: "pin",
  npm: {
    extends: [
      ":automergePatch",
      ":noUnscheduledUpdates",
      ":separatePatchReleases",
      "helpers:disableTypesNodeMajor",
    ],
    schedule: ["* 9-11 * * 1-5"],
    // `pin` would turn the `>=` ranges in pnpm-workspace.yaml overrides into exact versions
    rangeStrategy: "bump",
    postUpdateOptions: ["pnpmDedupe"],
    packageRules: [
      {
        // set `chore` to the commit for updating packages
        matchPackageNames: ["*"],
        semanticCommitType: "chore",
      },
      {
        groupName: "ESLint and Prettier",
        matchPackageNames: [
          "eslint",
          "prettier",
          "/^eslint-config-/",
          "/^eslint-plugin-/",
          "@cybozu/eslint-config",
        ],
      },
      {
        // automerge minor updates of devDependencies
        matchPackageNames: ["*"],
        matchDepTypes: ["devDependencies"],
        matchUpdateTypes: ["minor"],
        automerge: true,
      },
      {
        description: "disable package.json > engines update",
        matchDepTypes: ["engines"],
        enabled: false,
      },
    ],
  },
  packageRules: [
    {
      description: "Renovate cannot enforce minimumReleaseAge for these update types",
      matchUpdateTypes: [
        "lockFileMaintenance",
        "replacement",
        "pin",
        "bump",
        "lockfileUpdate",
        "rollback",
      ],
      minimumReleaseAge: null,
    },
    {
      // Third party actions should be pinned with digest
      matchDepTypes: ["action"],
      matchPackageNames: ["!actions/{/,}**", "!cybozu/{/,}**"],
      pinDigests: true,
    },
  ],
}
